{
  "description": "easifem-dev guards: edits only on -claude branches; ask before install, clean, deletes, risky git commands and fortitude without --no-fix.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_shell.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard_branch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
